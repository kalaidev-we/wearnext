# ==============================================================================
# WearNextFabs — Environment Variables Configuration
# Copy this file to .env.local for local development.
# ==============================================================================

# Public Site Configuration
NEXT_PUBLIC_SITE_URL=https://wearnextfabs.com

# Transactional Email Notification Service (Resend or equivalent SMTP)
# Sign up at https://resend.com to generate an API key.
RESEND_API_KEY=re_your_api_key_here
NOTIFICATION_RECIPIENT_EMAIL=enquiries@wearnextfabs.com
PARTNERSHIP_RECIPIENT_EMAIL=partnerships@wearnextfabs.com

# Storage Provider for Client Uploaded Tech-Packs (Supabase Storage or AWS S3)
# Private buckets ensure user tech-pack uploads are not publicly discoverable.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=private-techpacks

# Optional Database Connection (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:password@localhost:5432/wearnextfabs
